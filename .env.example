# Server-only; copy to .env.local. Never send keys in chat.
MODEL_API_KEY=
PACKPROOF_CONFIRMED_CREDITS_USD=140
# Probe reserves $0.50 per inference request in a persistent server-only ledger.
# Final two repair calls reserve $0.25 each; at most 7 calls / $3 total reserved.
# Pricing snapshot and reservation history are in evidence/P0.md.
# P0 may provision only an explicitly authorized, confirmed-free project.
PACKPROOF_HTTPS_TARGET=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never put these values in frontend/public configuration.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Optional Supabase CA certificate path for psql verify-full.
SUPABASE_DB_SSLROOTCERT=
# For phone access use a certificate trusted by the intended Android phones.
PROBE_TLS_CERT=
PROBE_TLS_KEY=
PROBE_HOST=127.0.0.1
PROBE_PORT=4173

# Optional later tracing; the P0 compatibility spike uses offline transport only.
# Automatic raw LangChain tracing is suppressed by the compatibility boundary.
LANGSMITH_API_KEY=
