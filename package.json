{
  "name": "packproof-p0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run tests/unit",
    "build": "pnpm probe:build && next build --webpack",
    "probe:serve": "node --env-file-if-exists=.env.local --import tsx scripts/spikes/serve.ts",
    "probe:crypto": "node --import tsx scripts/spikes/crypto-browser.ts",
    "probe:provider": "node --env-file-if-exists=.env.local --import tsx scripts/spikes/provider.ts",
    "probe:access": "node --env-file-if-exists=.env.local --import tsx scripts/spikes/access.ts",
    "probe:bundle": "node --import tsx scripts/spikes/check-bundle.ts",
    "probe:langchain": "node --import tsx scripts/spikes/langchain-offline.ts",
    "probe:phone": "node --import tsx scripts/spikes/phone-browser.ts",
    "probe:package": "node --import tsx scripts/spikes/package-probe.ts",
    "probe:infrastructure": "node --env-file-if-exists=.env.local --import tsx scripts/spikes/infrastructure.ts",
    "probe:deployment": "node --import tsx scripts/spikes/deployment-browser.ts",
    "db:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/p1/database.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/p1/migrate.ts",
    "demo:prepare": "node --import tsx scripts/p1/seed.ts --prepare",
    "demo:seed": "node --env-file-if-exists=.env.local --import tsx scripts/p1/seed.ts",
    "record:sign": "node --import tsx scripts/p1/sign.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx node_modules/vitest/vitest.mjs run tests/integration",
    "demo:read": "node --env-file-if-exists=.env.local --import tsx scripts/p1/read.ts",
    "probe:build": "node --import tsx scripts/spikes/build.ts",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "start": "next start --hostname 0.0.0.0",
    "db:migrate:p1b": "node --env-file-if-exists=.env.local --import tsx scripts/p1b/migrate.ts",
    "db:migrate:performance": "node --env-file-if-exists=.env.local --import tsx scripts/p1b/migrate-performance.ts",
    "evaluate:p1b": "node --env-file-if-exists=.env.local --import tsx scripts/p1b/evaluate.ts",
    "p1c:budget": "node --import tsx scripts/p1c/budget.ts",
    "p1c:live": "node --env-file-if-exists=.env.local --import tsx scripts/p1c/live.ts",
    "p1c:complete": "node --env-file-if-exists=.env.local --import tsx scripts/p1c/complete.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/openai": "1.8.0",
    "@meta-sam/parser": "0.1.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "jose": "6.2.14",
    "langsmith": "0.11.6",
    "next": "16.4.3",
    "openai": "7.45.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
